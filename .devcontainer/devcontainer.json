// postCreate: git config --global commit.gpgsign false; git config --local core.pager \"less -R\"; npm install -g pnpm@latest; npm install -g pm2 && pnpm install --force
// postStart: npx pm2-runtime start ecosystem.config.js --no-auto-exit
{
    "name": "Project monorepo devcontainer",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-bookworm",
    "mounts": [
        "source=${localEnv:HOME}/Documents/zscaler-root-ca.pem,target=/home/node/zscaler-root-ca.pem,type=bind,consistency=cached"
    ],
    "forwardPorts": [
        8787,
        3005,
        3001
    ],
    "portsAttributes": {
        "8787": {
            "label": "Hono Dev Server",
            "onAutoForward": "notify"
        },
        "3005": {
            "label": "Nuxt Dev Server",
            "onAutoForward": "notify"
        },
        "3001": {
            "label": "Nuxt Preview Server",
            "onAutoForward": "silent"
        }
    },
    "postCreateCommand": "echo hello1",
    "postStartCommand": "echo hello2",
    "remoteUser": "node",
    "workspaceFolder": "/workspaces/shindig",
    "containerEnv": {
        "NODE_ENV": "development",
        "NODE_EXTRA_CA_CERTS": "/home/node/zscaler-root-ca.pem"
    },
    "remoteEnv": {
        "NODE_ENV": "development"
    },
    "shutdownAction": "stopContainer"
}