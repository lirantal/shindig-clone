{
    "name": "Project monorepo devcontainer",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-bookworm",
    "forwardPorts": [
        8787,
        3005,
        3001
    ],
    "portsAttributes": {
        "8787": {
            "label": "Hono Dev Server",
            "onAutoForward": "notify"
        },
        "3005": {
            "label": "Nuxt Dev Server",
            "onAutoForward": "notify"
        },
        "3001": {
            "label": "Nuxt Preview Server",
            "onAutoForward": "silent"
        }
    },
    "postCreateCommand": "git config --global commit.gpgsign false; git config --local core.pager \"less -R\"; pnpm install --force",
    // "postStartCommand": "echo hello2",
    "remoteUser": "node",
    "workspaceFolder": "/workspaces/shindig",
    "containerEnv": {
        "NODE_ENV": "development",
    },
    "remoteEnv": {
        "NODE_ENV": "development"
    },
    "shutdownAction": "stopContainer"
}
